From 538c305bee2e2d8ccfa08e7b8c24efa0ba1cf541 Mon Sep 17 00:00:00 2001
From: Jens Georg <jens.georg@desy.de>
Date: Wed, 5 Jun 2024 16:14:23 +0200
Subject: [PATCH] Drop RPATH handling

Upstream-Status: Denied

Upstream wants to keep RPATH handling
---
 CMakeLists.txt | 1 -
 1 file changed, 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 259e168..248782b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -41,7 +41,6 @@ pybind11_add_module( ${PROJECT_NAME} ${headers} ${sources} )
 
 target_link_libraries( ${PROJECT_NAME} PRIVATE ChimeraTK::ChimeraTK-DeviceAccess )
 
-set_property( TARGET ${PROJECT_NAME} PROPERTY INSTALL_RPATH_USE_LINK_PATH TRUE )
 
 # set the right output file name for the the python core module library
 set_target_properties( ${PROJECT_NAME} PROPERTIES PREFIX "" OUTPUT_NAME "deviceaccess" )
