index 1404817..d760f2c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -39,7 +39,6 @@ file(COPY tests/reference-output DESTINATION ${PROJECT_BINARY_DIR}/tests)
 
 # Fixme: Once we switch to newer CMake, use FindPython3
 find_package(Python3 REQUIRED)
