From c3ac1fe8ab4a78bf0470630a35b6c57a7ef1fdfc Mon Sep 17 00:00:00 2001
From: Jens Georg <jens.georg@desy.de>
Date: Fri, 3 Jul 2026 09:55:01 +0000
Subject: [PATCH] Bump Libxml++ to 5.0

Upstream-Status: Submitted
---
 CMakeLists.txt        |  2 +-
 src/CatalogueCache.cc | 30 +++++++++++++++---------------
 2 files changed, 16 insertions(+), 16 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index c22e446..544fb28 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -21,7 +21,7 @@ FIND_PACKAGE(Boost REQUIRED COMPONENTS thread system filesystem unit_test_framew
 include_directories(${CMAKE_SOURCE_DIR}/include)
 FIND_PACKAGE(PkgConfig REQUIRED)
 
-set(LIBXML++_VERSION "libxml++-2.6")
+set(LIBXML++_VERSION "libxml++-5.0")
 PKG_CHECK_MODULES(LibXML++ REQUIRED IMPORTED_TARGET ${LIBXML++_VERSION})
 
 set(${PROJECT_NAME}_INCLUDE_DIRS ${${PROJECT_NAME}_INCLUDE_DIRS} ${CMAKE_SOURCE_DIR}/include/)
diff --git a/src/CatalogueCache.cc b/src/CatalogueCache.cc
index 88b9fef..b46644c 100644
--- a/src/CatalogueCache.cc
+++ b/src/CatalogueCache.cc
@@ -28,7 +28,7 @@ namespace Cache {
   static unsigned int parseLength(xmlpp::Element const* c);
   static int parseTypeId(xmlpp::Element const* c);
   static ChimeraTK::AccessModeFlags parseAccessMode(xmlpp::Element const* c);
-  static void addRegInfoXmlNode(const DoocsBackendRegisterInfo& r, xmlpp::Node* rootNode);
+  static void addRegInfoXmlNode(const DoocsBackendRegisterInfo& r, xmlpp::Element* rootNode);
 
   /********************************************************************************************************************/
 
@@ -115,7 +115,7 @@ namespace Cache {
       std::string nodeName = e->get_name();
 
       if(nodeName == "name") {
-        name = e->get_child_text()->get_content();
+        name = e->get_first_child_text()->get_content();
       }
       else if(nodeName == "length") {
         len = parseLength(e);
@@ -144,20 +144,20 @@ namespace Cache {
   /********************************************************************************************************************/
 
   unsigned int parseLength(xmlpp::Element const* c) {
-    return convertToUint(c->get_child_text()->get_content(), c->get_line());
+    return convertToUint(c->get_first_child_text()->get_content(), c->get_line());
   }
 
   /********************************************************************************************************************/
 
   int parseTypeId(xmlpp::Element const* c) {
-    return convertToInt(c->get_child_text()->get_content(), c->get_line());
+    return convertToInt(c->get_first_child_text()->get_content(), c->get_line());
   }
 
   /********************************************************************************************************************/
 
   ChimeraTK::AccessModeFlags parseAccessMode(xmlpp::Element const* c) {
     std::string accessMode{};
-    auto t = c->get_child_text();
+    auto t = c->get_first_child_text();
     if(t != nullptr) {
       accessMode = t->get_content();
     }
@@ -219,20 +219,20 @@ namespace Cache {
 
   /********************************************************************************************************************/
 
-  void addRegInfoXmlNode(const DoocsBackendRegisterInfo& r, xmlpp::Node* rootNode) {
-    auto registerTag = rootNode->add_child("register");
+  void addRegInfoXmlNode(const DoocsBackendRegisterInfo& r, xmlpp::Element* rootNode) {
+    auto registerTag = rootNode->add_child_element("register");
 
-    auto nameTag = registerTag->add_child("name");
-    nameTag->set_child_text(static_cast<std::string>(r.getRegisterName()));
+    auto nameTag = registerTag->add_child_element("name");
+    nameTag->set_first_child_text(static_cast<std::string>(r.getRegisterName()));
 
-    auto lengthTag = registerTag->add_child("length");
-    lengthTag->set_child_text(std::to_string(r.getNumberOfElements()));
+    auto lengthTag = registerTag->add_child_element("length");
+    lengthTag->set_first_child_text(std::to_string(r.getNumberOfElements()));
 
-    auto accessMode = registerTag->add_child("access_mode");
-    accessMode->set_child_text(r.accessModeFlags.serialize());
+    auto accessMode = registerTag->add_child_element("access_mode");
+    accessMode->set_first_child_text(r.accessModeFlags.serialize());
 
-    auto typeId = registerTag->add_child("doocs_type_id");
-    typeId->set_child_text(std::to_string(r.doocsTypeId));
+    auto typeId = registerTag->add_child_element("doocs_type_id");
+    typeId->set_first_child_text(std::to_string(r.doocsTypeId));
 
     std::string comment_text = std::string("doocs id: ") + doocs::EqData().type_string(r.doocsTypeId);
     registerTag->add_child_comment(comment_text);
